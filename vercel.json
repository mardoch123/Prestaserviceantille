{
  "rewrites": [
    {
      "source": "/api/supabase/(.*)",
      "destination": "/api/supabase-proxy.js?path=$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/purge-device-tokens",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/auto-generate-split-invoices",
      "schedule": "0 */2 * * *"
    }
  ]
}
